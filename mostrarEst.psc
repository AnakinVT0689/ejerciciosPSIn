Algoritmo sin_titulo
    Definir estaturas[4] Como Real
    Para i <- 0 Hasta 4 Con Paso 1 Hacer
        Escribir "Ingrese estatura"
        Leer estaturas[i]
    FinPara
    mostrarEst(estaturas)
FinAlgoritmo

Proceso mostrarEst(estaturas)
    Para i <- 0 Hasta 4 Con Paso 1 Hacer
        Escribir "estatura", estaturas[i]
    FinPara
FinProceso

	